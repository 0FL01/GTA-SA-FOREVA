; Engine configuration file.
; Edit through the Godot editor when possible.
config_version=5

[application]

config/name="SA Legacy Look Lab"
run/main_scene="res://lab.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
scaling_3d/mode=0
scaling_3d/scale=1.0
textures/default_filters/use_nearest_mipmap_filter=false
